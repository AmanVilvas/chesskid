NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://postgres:change-me@localhost:5432/thinking_academy
DATABASE_SSL=false
# Set to 1 only when exactly one trusted reverse proxy sits in front of Node.
TRUST_PROXY=0
SESSION_TTL_HOURS=12
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Price in paise. For example, ₹4,999 is 499900. 0 makes the seeded course free.
BEGINNER_COURSE_PRICE_PAISE=0
BEGINNER_COURSE_CURRENCY=INR
PRIVATE_ASSET_ROOT=./private-assets
